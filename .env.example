# Copy to .env and fill in. Never commit real secrets.

# --- Required in production -------------------------------------------------
SPRING_PROFILES_ACTIVE=prod            # "dev" enables demo data and exposes dev verification links. Never use dev in production.
JWT_SECRET=                            # at least 32 random bytes, e.g. `openssl rand -hex 48`
HASH_SALT=                             # random string used to hash IP addresses, e.g. `openssl rand -hex 24`
DB_URL=jdbc:postgresql://postgres:5432/promora
DB_USER=promora
DB_PASSWORD=change-me
PUBLIC_URL=http://localhost:5173       # where the website is served (used in emails, sitemap and tracking redirects)
API_URL=http://localhost:5173          # public origin that serves /r/{code} tracking links
CORS_ORIGINS=http://localhost:5173
COOKIES_SECURE=false                   # true when served over HTTPS
FORWARD_HEADERS=none                   # "framework" only when running behind a trusted reverse proxy

# First super admin. Created once at start-up when no account with this email exists. Password: 12+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Payments (Razorpay). Leave empty to run the built-in sandbox: no real money moves. ----------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email. Leave MAIL_HOST empty to log emails instead of sending. Docker Compose points this at Mailpit. ----
MAIL_HOST=
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@promora.local

# --- AI campaign assistant (any provider with a chat-completions compatible API). Leave empty to disable. ----
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Optional ----------------------------------------------------------------
REDIS_ENABLED=false                    # true: rate limits are shared across instances through Redis
REDIS_HOST=redis
REDIS_PORT=6379
STORAGE_DIR=./data/uploads             # local upload directory (the StorageService abstraction can be replaced by S3)
SEED_DEMO_DATA=true                    # dev profile only
